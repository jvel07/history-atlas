# Frontend — build time.
# Unset is a supported mode, not a broken one: the site runs on its written
# lenses and local search index with no backend at all.
VITE_ATLAS_API=https://<project-ref>.supabase.co/functions/v1

# Vite base path. Defaults to /history-atlas/ to match the repo name on GitHub
# Pages. Use / for a root-served host.
# BASE=/

# --------------------------------------------------------------------------
# Backend. These are Edge Function secrets and the ingest script's environment.
# They never belong in a VITE_ variable — anything prefixed VITE_ is compiled
# into the bundle and served to every reader.
#
#   supabase secrets set ANTHROPIC_API_KEY=... VOYAGE_API_KEY=...
# --------------------------------------------------------------------------

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Generation. console.anthropic.com
ANTHROPIC_API_KEY=

# Embeddings — voyage-3, 1024 dimensions. Changing the model means changing the
# vector width in schema.sql and re-embedding the whole corpus.
VOYAGE_API_KEY=

# Optional overrides
# ATLAS_MODEL=claude-sonnet-5
# ATLAS_ALLOWED_ORIGIN=https://jvel07.github.io
